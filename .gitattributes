# かな漢字変換の全面辞書。EUC-JP のため改行変換(CRLF)や差分表示を無効化し、
# バイナリ資産として扱う(破損防止・diff肥大化防止)。
kiosk_agent/SKK-JISYO.L -text -diff

# 声で操作する(実験導入)の Vosk モデル(zip)。取得元とハッシュは
# kiosk_agent/scripts/fetch_voice_models.py に固定してある。
kiosk_agent/voice_models/*.zip filter=lfs diff=lfs merge=lfs -text

# システム更新(管理者権限で動く側)。署名はファイルのハッシュに付くので、端末(Linux)へ
# 届く形と同じ LF で固定する(CRLF になると署名と合わなくなる)。install.sh も端末で動く。
kiosk_agent/system/** text eol=lf
kiosk_agent/install.sh text eol=lf
kiosk_agent/scripts/sign_system.sh text eol=lf
