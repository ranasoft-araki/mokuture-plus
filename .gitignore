# Environment
.env
.env.local
.env.*.local
.env.production
backend/.env.production

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
*.egg-info/
dist/
.pytest_cache/

# Node
node_modules/
.next/
out/
.vercel/
frontend/.netlify/

# Database (local dev SQLite)
*.db
*.db-shm
*.db-wal

# Kiosk agent per-device state (端末ごとのローカル状態・実トークンを含む。コミット禁止)
# フォーマットは device_state.json.example を参照。実体は /register 時に agent が自動生成する。
kiosk_agent/device_state.json
kiosk_agent/locker_state.json

# Kiosk agent かな漢字辞書のダウンロード中間物(SKK-JISYO.L 本体は資産として commit 済み)
kiosk_agent/SKK-JISYO.L.gz

# 名刺 OCR のモデル(約 23MB)。scripts/fetch_ocr_models.py が導入時に取得する。
# ハッシュ付きの取得元はスクリプト側に書いてあるので、リポジトリには置かない。
kiosk_agent/models/

# 名刺テストの生成画像。tests/make_fixtures.py がその場で作る(実在の名刺は使わない)。
kiosk_agent/tests/fixtures/

# 端末ごとの名刺読み取り設定(現場でしきい値を調整したもの)。
# 配布するのは card_reader.yaml.example のほう。
kiosk_agent/card_reader.yaml

# 端末ごとの音声入力設定(マイクのデバイス名・しきい値・使うモデル)。
# 配布するのは voice_input.yaml.example のほう。
kiosk_agent/voice_input.yaml

# 担当者の読み仮名。実在の社員の氏名・読み・部署が入るのでコミット禁止。
# 配布するのは staff_readings.yaml.example（記入例は架空の人物）のほう。
kiosk_agent/staff_readings.yaml

# whisper.cpp の展開先とビルド成果物。配信するのは vendor/*.tar.gz(固定版ソース)
# だけで、バイナリは端末ごとに install_voice.sh がビルドする(aarch64 専用のため)。
kiosk_agent/vendor/whisper.cpp/

# Windows 動作試験用の whisper.cpp 配布バイナリ(install_voice_windows.ps1 が展開する)。
# プラットフォーム固有の実行ファイルなのでリポジトリには入れない。
kiosk_agent/vendor/whisper.cpp-win-x64/

# Vosk モデルの展開先(zip を fetch_voice_models.py --extract で開いたもの)。
# リポジトリに入っているのは zip のほう。
kiosk_agent/voice_models/vosk-model-small-ja-0.22/

# 音声入力の匿名メトリクス(端末内にだけ置く。既定は ~/.mokuture-voice/)
kiosk_agent/**/metrics.jsonl*

# Misc
.DS_Store
*.log
