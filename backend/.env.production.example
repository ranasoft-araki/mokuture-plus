# ---- Neon PostgreSQL ----
DATABASE_URL=postgresql+asyncpg://neondb_owner:<PASSWORD>@ep-crimson-moon-a6tt9ssy.us-west-2.aws.neon.tech/neondb?ssl=require

# ---- JWT ----
JWT_SECRET_KEY=<256-bit random hex: python3 -c "import secrets; print(secrets.token_hex(32))">
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=30

# ---- Fernet encryption ----
ENCRYPTION_KEY=<base64: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())">

# ---- Cloudflare R2 ----
STORAGE_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY_ID=<R2_ACCESS_KEY>
STORAGE_SECRET_ACCESS_KEY=<R2_SECRET_KEY>
STORAGE_BUCKET_NAME=mokuture
STORAGE_PUBLIC_URL=https://pub-<...>.r2.dev/mokuture

# ---- CORS ----
ALLOWED_ORIGINS=["https://mokuture-plus.netlify.app"]

# ---- SMTP メール送信(来社予定QRのメール送信) ----
# host/username/password が揃うと有効。587=STARTTLS / 465=SMTP_SSL=true(SMTP_STARTTLS=false)。
# 注意: Render は無料/starter プランで送信SMTPポート(587/465)を塞ぐことがある。
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=<送信元アドレス>
SMTP_PASSWORD=<Gmailはアプリパスワード>
SMTP_FROM=
SMTP_FROM_NAME=
SMTP_STARTTLS=true
SMTP_SSL=false

# ---- Misc ----
DEBUG=false
