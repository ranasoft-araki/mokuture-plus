# Copy to .env and fill in values. Never commit .env to git.

# App
DEBUG=true

# Database (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./mokuture.db
# DATABASE_URL=postgresql+asyncpg://user:password@host/dbname

# JWT — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-use-256bit-random

# Storage (MinIO for local dev, Cloudflare R2 for production)
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_BUCKET_NAME=mokuture
STORAGE_PUBLIC_URL=http://localhost:9000/mokuture

# Encryption — generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me-generate-with-Fernet

# CORS (comma-separated)
ALLOWED_ORIGINS=["http://localhost:3000"]

# VAPID for Web Push (optional in Phase 0)
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:admin@mokuture.jp

# Slack OAuth (「Slackに追加」= Bot Token + chat.postMessage). Leave blank to disable.
# Register SLACK_REDIRECT_URI as a Redirect URL on the Slack App (OAuth & Permissions)
# and add Bot Token Scopes: chat:write, channels:read, groups:read, channels:join.
#   prod: https://mokuture-plus-api.onrender.com/api/notifications/slack/callback
#   dev:  http://localhost:8001/api/notifications/slack/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=

# SMTP メール送信(来社予定QRのメール送信). host/username/password が揃うと有効。
# Gmail の例(2段階認証+アプリパスワード): host=smtp.gmail.com port=587 starttls=true, username=送信元@gmail.com, password=アプリパスワード
# 465(implicit TLS)を使う場合は SMTP_PORT=465 SMTP_SSL=true SMTP_STARTTLS=false。
# 注意: Render は無料/starter プランで送信SMTPポート(587/465)を塞ぐことがある(本番で失敗する場合はプラン/経路を確認)。
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=              # 差出人アドレス(空なら SMTP_USERNAME)
SMTP_FROM_NAME=         # 差出人表示名(空ならテナント名)
SMTP_STARTTLS=true
SMTP_SSL=false
