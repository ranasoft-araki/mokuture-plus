[Unit]
Description=mokuture+ Kiosk Device Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=USER
WorkingDirectory=AGENT_DIR
# 端末の中(キオスク画面の Chromium)からだけ使うので 127.0.0.1 で待ち受ける。
# このファイルは OTA で配られない。変えたら各端末で install.sh を流し直すこと。
ExecStart=VENV/bin/uvicorn main:app --host 127.0.0.1 --port 8080 --no-access-log
Restart=always
RestartSec=5
WatchdogSec=30
EnvironmentFile=AGENT_DIR/.env
Environment=XDG_RUNTIME_DIR=/run/user/1000
ExecStartPost=/usr/bin/systemctl --user restart mokuture-browser.service

[Install]
WantedBy=multi-user.target
