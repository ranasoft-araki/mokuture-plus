# 名刺認識の設定ファイル（例）
#
#   cp card_reader.yaml.example card_reader.yaml
#
# このファイルをそのまま置けば既定値と同じ挙動になる。変えたい項目だけ残して
# 他は消してもよい（書かれていない項目は card/defaults.py の既定値が使われる）。
# 読み込みは起動時のみ。編集したらエージェントを再起動すること。
#   sudo systemctl restart mokuture-kiosk
#
# 環境変数でも上書きできる（YAML より優先）。区切りは二重アンダースコア。
#   CARD_OCR__ENGINE=tesseract
#   CARD_QUALITY__FOCUS_MIN=40
#   CARD_PREPROCESS__VARIANTS=color,gray,binary
#
# 現在どの値で動いているかは GET /card/status で確認できる。

# 名刺読み取り機能そのものの有効/無効。false にすると受付画面から導線が消える。
enabled: true

# /card/* をこの端末自身（127.0.0.1）からのリクエストに限る。
# キオスクのブラウザは同じ端末なので、通常は true のままでよい。
bind_loopback_only: true

camera:
  # ブラウザが検出ループで送ってくるフレームの最大幅(px)。大きくすると検出は
  # わずかに良くなるが、1 フレームあたりの処理時間と転送量が増える。
  detect_frame_max_width: 640
  # 撮影（OCR にかける）フレームの最大幅(px)。小さすぎると細かい文字が潰れる。
  capture_max_width: 2048
  # 検出ループの送信間隔(ms)。短くすると反応が良くなるが CPU を食う。
  detect_interval_ms: 120

detection:
  # 検出は必ずこの幅に縮小してから行う（入力解像度で挙動が変わらないように）。
  work_width: 640
  blur_kernel: 5
  # エッジの途切れを閉じるクロージングのカーネル幅（奇数）。
  close_kernel: 13
  canny_low: 60
  canny_high: 180
  # 低コントラスト（白い名刺を明るい机に置いた場合）や暗所向けのエッジ抽出。
  # gradient_thresh を上げると木目などの誤検出が減り、白い名刺は取りにくくなる。
  normalize_lo_pct: 1.0
  normalize_hi_pct: 99.0
  # しきい値は max(gradient_thresh, 勾配の gradient_noise_pct 百分位 × gradient_noise_mult)。
  # ノイズの多い映像では自動的に上がる。誤検出が多いなら mult を上げる。
  gradient_thresh: 5
  gradient_noise_pct: 90.0
  gradient_noise_mult: 1.6
  # 白飛び画素がこの割合を超えたら、固定しきい値のエッジ抽出も試す（反射対策）。
  glare_fallback_ratio: 0.02
  approx_epsilon: 0.02
  # 四隅を辺ごとの直線当てはめで取り直す（縦型名刺など、画面内で小さいときに効く）。
  refine_corners: true
  # 候補として拾う面積の下限/上限（画面に占める割合）。
  # 「小さすぎます」の案内は quality.capture_area_min が出すので、ここは低めでよい。
  min_area_ratio: 0.02
  max_area_ratio: 0.95
  # 長辺/短辺。日本の標準名刺 91x55mm = 1.65。
  # 上限を 1.92 にしているのはスマートフォンの画面（約 2.0）を弾くため。
  aspect_min: 1.45
  aspect_max: 1.92
  margin_px: 4
  # 名刺の内側に「文字らしい領域」がこれ以上あることを要求する（木目対策）。
  # 辺のうち輝度の段差がある割合の下限（背景のエッジをつないだ四角形を落とす）。
  min_edge_support: 0.55
  edge_support_mult: 1.4
  edge_support_window: 4
  # 追跡中（直前と同じ位置）は辺の裏付けの条件をこの倍率に緩める。
  track_motion_max: 0.05
  track_support_relax: 0.7
  # 内側がこの割合を超えて肌色なら名刺としない（顔・手のひら対策）。
  max_skin_ratio: 0.15
  # 肌との境目もエッジとして使う（名刺を手に持ったときの縁を拾う）。
  use_skin_boundary: true
  # 肌色の範囲（YCrCb）。照明で肌の明るさは変わるのでここで調整する。
  # skin_luma_max は「生成りの紙を肌と間違えない」ための明るさの上限。
  skin_cr_min: 133
  skin_cr_max: 173
  skin_cb_min: 77
  skin_cb_max: 127
  skin_cr_cb_min: 15
  skin_luma_max: 225
  # 候補を「肌なので名刺ではない」と落とすときの明るさの上限（厳しい側）。
  # 上げると生成り・クラフト紙の名刺が読めなくなる。
  skin_reject_luma_max: 165
  min_text_regions: 3
  # 紙の縁で四角形が組めなかったときに、文字の並びから名刺の位置を決める。
  # 手に持った名刺は縁が指・逆光・同系色の背景で消えることが多く、実機の失敗画面
  # ではエッジ側の候補が 1 つも通らなかった。詳しくは card/text_detect.py を参照。
  text_fallback: true
  text_block_size: 25
  text_c: 10
  text_min_height_px: 3
  text_max_height_ratio: 0.12
  text_max_width_ratio: 0.30
  text_max_aspect: 10.0
  text_min_fill: 0.12
  text_min_boxes: 20
  text_min_rows: 2
  text_link_x: 3.0
  text_link_y: 5.0
  text_pad_ratio: 2.5
  # 密なかたまりのすぐ外にある文字を取り込む距離(字高の倍数)と回数。
  text_absorb_ratio_x: 2.0
  text_absorb_ratio_y: 16.0
  text_absorb_passes: 3
  # 名刺の形ではないが外形がはっきりしている物体(A4 の書類・スマホの画面)が
  # 写っていたら、その上の文字を名刺と見ない。
  text_veto_min_area: 0.10
  text_veto_support: 0.70
  # この面積比以上で見つかったら残りのエッジ抽出戦略は試さない。
  strategy_stop_area: 0.12
  # この点数の候補が出たら同じエッジ画像の残りは調べない（速度のため）。
  candidate_stop_score: 0.80
  max_candidates: 12
  min_corner_angle_deg: 60
  max_corner_angle_deg: 120

quality:
  # 自動撮影に進んでよい名刺の大きさ。「その向きで写せる最大の何割か」で測るので、
  # 縦型・横型のどちらでも同じ基準になる（面積比だと縦型が原理的に不利）。
  capture_fill_min: 0.50
  capture_fill_max: 0.99
  # ピント。Laplacian 分散がこれを下回ると「ピントを合わせています」。
  # カメラと照明で妥当な値が変わるので、実機では scripts/bench.py --metrics で
  # 実際の数値を見てから決めること。
  focus_min: 60.0
  # 明るさは名刺領域の上位 5% 点で測る（濃色の名刺を暗所と誤判定しないため）。
  brightness_min: 90.0
  brightness_max: 253.0
  # 名刺領域のうち白飛び（輝度 250 以上）している割合の上限。
  glare_max: 0.06
  # 四隅の移動量（画面短辺比）の上限。これを超えると「動かさずにお待ちください」。
  # 手に持った名刺は必ず揺れる。机置き前提の厳しさだと撮影に進まない。
  motion_max: 0.030
  # 条件を満たすフレームがこの回数続いたら自動撮影する。
  # 読み取りに失敗したら自動で撮り直すので、ここは短め（検出間隔 120ms × 3 ≒ 0.4 秒）。
  stable_frames: 3
  capture_cooldown_sec: 1.5
  # 文字ベースで見つけたときの「近づいてください」の判定（字が読める大きさか）。
  # 検出フレーム(640px 幅)での字の高さ。
  text_height_min: 5.5

preprocess:
  output_width: 1024
  # OCR にかける前処理の種類と順番。上から試し、early_accept_score を超えたら打ち切る。
  # 選べるのは raw / color / gray / binary / sharp。増やすほど精度は上がるが遅くなる。
  variants:
    - color
    - gray
    - binary
  early_accept_score: 0.86
  min_text_height_px: 18
  upscale_max: 2.0
  clahe_clip: 2.0
  clahe_grid: 8
  denoise: true
  sharpen: true
  binary_block: 31
  binary_c: 10

ocr:
  # paddle_onnx（第一候補・日本語 PP-OCRv4 を ONNX Runtime で実行）
  # tesseract （第二候補・ARM64 で onnxruntime が入らない場合）
  engine: paddle_onnx
  timeout_sec: 20.0
  # ONNX Runtime のスレッド数。Pi 5(4 コア)では 3 にして 1 コアを UI に残す。
  threads: 3
  paddle_onnx:
    det_model: models/det.onnx
    rec_model: models/rec_japan.onnx
    rec_dict: models/japan_dict.txt
    # 任意。行ごとの 180 度反転を直す方向分類モデル。空文字なら使わない。
    cls_model: models/cls.onnx
    # 任意。英数字専用モデル。日本語モデルの文字セットには "@" と "_" が無く
    # メールアドレスを出力できないため、英数字だけの行はこちらで読み直す。
    rec_model_en: models/rec_en.onnx
    rec_dict_en: models/en_dict.txt
    det_limit_side_len: 960
    det_db_thresh: 0.3
    det_db_box_thresh: 0.5
    det_db_unclip_ratio: 1.7
    det_min_box_side: 4
    rec_image_height: 48
    rec_batch: 6
    use_space_char: true
    drop_score: 0.5
    # 縦書き対応。縦長の枠を「1 文字ずつ読む（縦書き）」解釈でも試し、
    # 倒れた横書きとして読むより確からしければそちらを採る。
    vertical_text: true
    vertical_ratio: 1.5
    vertical_margin: 0.05
    vertical_try_below: 0.75
    en_pass_max_lines: 4
    vertical_batch: 32
  tesseract:
    cmd: tesseract
    lang: jpn+eng
    psm: 6
    oem: 3
    drop_score: 0.4

extraction:
  # 部署・役職・法人格などの辞書の場所。ここのテキストファイルは運用中に
  # 追記してよい（保存すると次の読み取りから反映される。再起動不要）。
  dictionaries_dir: card/dictionaries
  # 氏名がこの確信度に届かないときは確定せず、候補として画面に出す。
  name_min_conf: 0.45
  large_text_ratio: 0.72

# 撮影して OCR した結果を「読み取れた」と見なす条件。満たしていれば確認画面へ進み、
# 満たしていなければ黙って撮り直す（＝空っぽの確認画面を見せない）。
accept:
  # このうち少なくとも 1 つは値が取れていること。空リストにすると種類を問わない。
  require_any:
    - person_name
    - company_name
  # 埋まった項目の数の下限。
  min_fields: 2
  # 全体の読み取り精度の下限。
  min_confidence: 0.35
  # 自動での撮り直しの上限。超えたら取れた分だけで確認画面へ進む（手入力できるように）。
  max_attempts: 5
  # 撮り直しまでの間隔（秒）。
  retry_cooldown_sec: 0.8

confidence:
  # 確認画面の色分け。ok 以上＝通常 / warn 以上＝黄（要確認）/ 未満＝赤（要入力）
  ok: 0.85
  warn: 0.60

session:
  # 無操作でセッション（＝メモリ上の名刺画像と抽出結果）を破棄するまでの秒数。
  ttl_sec: 180
  max_sessions: 4
  # 1 リクエストで受け取る画像の上限バイト数。
  max_frame_bytes: 4000000
