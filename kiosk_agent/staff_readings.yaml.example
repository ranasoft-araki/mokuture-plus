# 担当者の読み仮名(音声で訪問先を指名するため / 第3段階)
#
#   cp staff_readings.yaml.example staff_readings.yaml
#   （編集したら） sudo systemctl restart mokuture-voice
#
# ■ なぜ端末側にこのファイルがあるのか
#
# mokuture+ の社員マスターは `tenants.staff_list`（管理画面「受付設定」の担当者一覧）
# で、**表示氏名のカンマ区切りだけ**を持っている。読み仮名・部署・別称の欄が無い。
#
# 音声認識の結果はかな(または誤変換された漢字)で返ってくるので、読み仮名が無いと
# 照合できない。かといって氏名から読みを推測して確定するのは禁止されている
# （「田中」を「たなか」と決め打つと「たなご」「でんちゅう」等を取りこぼし、
#   別人を呼び出しかねない）。
#
# そこで **読み仮名が登録されている担当者だけ**を音声照合の対象にする。
# ここに載っていない担当者は「設定不足」として扱い、音声では選べない
# （タッチでは従来どおり選べるので、受付は問題なく完了できる）。
#
# 1 人も登録が無ければ、担当者の音声入力そのものが無効になる
# （/voice/status の features.staff が false になり、画面に導線が出ない）。
#
# ■ 書き方
#
# name は管理画面の担当者一覧（＝キオスクの訪問先ドロップダウン）と**完全に同じ文字列**
# にすること。ここが一致しないと、選んでもフォームに入らない。

staff:
  - name: 田中太郎          # 管理画面の担当者名と完全一致させる
    kana: たなかたろう      # 必須。無い人は音声照合の対象外になる
    department: 営業部      # 任意。「営業部の田中さん」の言い方に対応する
    aliases:                # 任意。社内での呼ばれ方・旧姓・通称
      - たなかさん
      - たろうさん

  - name: 田中一郎
    kana: たなかいちろう
    department: 総務部

  - name: 佐藤花子
    kana: さとうはなこ
    department: 総務部
    aliases:
      - さとうさん

# ■ 同姓が複数いる場合
#
# 「田中さん」と言われたら候補を最大 3 名まで画面に出して選んでもらう。
# 1 名に絞れても即座には呼び出さず、必ず確認画面を挟む。
# 部署まで言われた場合（「営業部の田中さん」）は department で絞り込む。
