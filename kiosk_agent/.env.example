# mokuture+ Kiosk Agent 設定ファイル
# .env にコピーして使用してください
#
# ※ デバイストークンはここには書きません。PIN も不要です。
#   キオスク画面(http://localhost:8080)を開くと TENANT_SLUG を使って自動で自己登録し、
#   「承認待ち」になります。管理画面「キオスク端末」で「承認する」を押すと起動します。
#   手動で登録をトリガーする場合: curl -X POST http://localhost:8080/register
#   → 取得したトークンは device_state.json に保存され、以後自動的に使用されます。

# テナントスラッグ (キオスクビルド・デバイス登録で使用)
TENANT_SLUG=isinokk

# リモート API エンドポイント
REMOTE_API_URL=https://mokuture-plus-api.onrender.com/api

# ローカルメディアキャッシュ保存先
# RPi: /home/pi/kiosk-media
# 開発機 (非RPi): /tmp/kiosk-media
MEDIA_DIR=/home/pi/kiosk-media

# エージェントがリッスンするポート (Chromium は http://localhost:8080 を開く)
PORT=8080

# コンテンツ同期間隔 (秒)
SYNC_INTERVAL_SEC=60

# GPIO モック (Raspberry Pi 以外の開発機では true に設定)
MOCK_GPIO=false

# PIR 人感センサーの GPIO ピン番号 (BCM)
PIR_PIN=4

# ドアセンサーと GPIO ピンの対応 (door_id → BCM pin)
DOOR_PINS_JSON={"1": 12, "2": 16, "3": 26}

# 電子錠リレーとGPIOピンの対応 (locker_id → BCM pin)
LOCKER_PINS_JSON={"1": 14, "2": 15, "3": 18}

# 電子錠リレーの開錠時間(秒)
LOCKER_PULSE_SEC=1.0

# USBカメラのデバイスパス
CAMERA_DEVICE=/dev/video0
