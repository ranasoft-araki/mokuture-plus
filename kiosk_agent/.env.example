# mokuture+ Kiosk Agent 設定ファイル
# .env にコピーして使用してください
#
# ※ デバイストークンはここには書きません。PIN も不要です。
#   キオスク画面(http://localhost:8080)を開くと TENANT_SLUG を使って自動で自己登録し、
#   「承認待ち」になります。管理画面「キオスク端末」で「承認する」を押すと起動します。
#   手動で登録をトリガーする場合: curl -X POST http://localhost:8080/register
#   → 取得したトークンは device_state.json に保存され、以後自動的に使用されます。

# テナントスラッグ (キオスクビルド・デバイス登録で使用)
TENANT_SLUG=isinokk

# リモート API エンドポイント
REMOTE_API_URL=https://mokuture-plus-api.onrender.com/api

# ローカルメディアキャッシュ保存先
# RPi: /home/pi/kiosk-media
# 開発機 (非RPi): /tmp/kiosk-media
MEDIA_DIR=/home/pi/kiosk-media

# エージェントがリッスンするポート (Chromium は http://localhost:8080 を開く)
PORT=8080

# コンテンツ同期間隔 (秒)
SYNC_INTERVAL_SEC=60

# systemd watchdog で kiosk.html の停止も見る場合は true
SYSTEMD_WATCHDOG_BROWSER_REQUIRED=false

# 起動後、この秒数までは最初の kiosk heartbeat 未着でも許容
SYSTEMD_WATCHDOG_BROWSER_STARTUP_GRACE_SEC=300

# kiosk heartbeat がこの秒数以上途絶えたら unhealthy 扱い
SYSTEMD_WATCHDOG_BROWSER_STALE_SEC=45

# GPIO モック (Raspberry Pi 以外の開発機では true に設定)
MOCK_GPIO=false

# PIR 人感センサーの GPIO ピン番号 (BCM)
PIR_PIN=4

# ── 来訪を検知するセンサー ──────────────────────────────────────────────
# auto    = 既定。距離センサーがつながっていればそれを、無ければ人感センサーを使う
#           (センサーを付け替えた端末で、ここを書かなくてよい。見つけるのは起動時)
# pir     = 人感センサーに固定(上の PIR_PIN につなぐ)
# vl53l0x = 距離センサー VL53L0X に固定(実用 1m 前後まで)
# vl53l1x = 距離センサー VL53L1X に固定(最大 約4m)
# 距離センサーの配線: VIN(VCC)→3.3V(17番ピン) / GND→GND / SDA→GPIO2(3番ピン) / SCL→GPIO3(5番ピン)
#   5V にはつながない。つないだら `i2cdetect -y 1` に 29 が出る。
#   部品(ライブラリ)と I2C の有効化は、システム更新(配信)が自動で行う。
# PRESENCE_SENSOR=auto
# この距離(mm)以内に近づいたら来訪とみなす。いまの距離は
# キオスク設定(左上＋右上を同時タッチ)→デバイスチェック→「人感センサー」に出る。
# TOF_THRESHOLD_MM=1000
# 近い読みが何回続いたら検知にするか(読みは 1 秒に 8 回前後。増やすと通りすがりで起きにくくなる)
# TOF_CONFIRM_READS=3
# 近いままがこの秒数続いたら、離れるまで検知を止める(置かれた物・向かいの壁で起き続けない)
# TOF_STALE_SEC=60

# ── ロッカーの口数(3口/7口) ─────────────────────────────────────────────
# 口数は「キオスク設定画面(左上＋右上を同時タッチ)→設定タブ→ロッカーの口数」で
# 設置者がタッチ選択し、端末ローカル(locker_state.json)に永続化される。増設時の
# 3口↔7口 切替もこの画面で完結＝現場でこのJSONを編集する必要はない。
# 下記ピンは 1〜3口のベース。7口の増設4口(4〜7)は main.py の既定ピン
# (_EXTRA_LOCKER_PINS / _EXTRA_DOOR_PINS)を使う。実機ハーネスに合わせて確定し、
# 既定ピンと配線が違う場合のみ 7口ぶんをここに書けば上書きできる。

# ドアセンサーと GPIO ピンの対応 (door_id → BCM pin)
DOOR_PINS_JSON={"1": 12, "2": 16, "3": 26}

# 電子錠リレーとGPIOピンの対応 (locker_id → BCM pin)
LOCKER_PINS_JSON={"1": 14, "2": 15, "3": 18}

# 電子錠リレーの開錠時間(秒)
LOCKER_PULSE_SEC=1.0

# USBカメラのデバイスパス
CAMERA_DEVICE=/dev/video0
